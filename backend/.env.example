# Application Configuration
APP_NAME="SmartCampus AI Video"
APP_ENV=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Compute & Model Acceleration
DEVICE=cuda
TORCH_DTYPE=float16

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60.0

# IndicF5 TTS Configuration
TTS_DEVICE=auto
TTS_MODEL_TYPE=F5TTS_v1_Base
NARRATION_TARGET_WPM=160
NARRATION_DURATION_TOLERANCE=0.20

# Whisper Subtitle Configuration
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# FFmpeg Composition Configuration
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
BURN_SUBTITLES=true
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
VIDEO_CRF=23
AUDIO_BITRATE=128k
PIXEL_FORMAT=yuv420p
MOVFLAGS=+faststart

# Avatar Configuration
AVATAR_ENABLED=false
AVATAR_PROVIDER=musetalk
AVATAR_CHARACTER=teacher
AVATAR_DEVICE=auto
AVATAR_MAX_VRAM_GB=4

# Hugging Face Video Configuration (Task 9A Proof of Concept)
HF_TOKEN=
HF_VIDEO_ENABLED=false
HF_VIDEO_PROVIDER=fal-ai
HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B
HF_VIDEO_TIMEOUT=300

# ElevenLabs Multilingual TTS Configuration (Task 9G-A)
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
ELEVENLABS_LANGUAGE=en
ELEVENLABS_TIMEOUT=120